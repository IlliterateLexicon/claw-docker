# build stage (pre claw)
from alpine as build 
run apk add --no-cache neovim

workdir /copy
run touch "hello world!"

workdir /copy/lib
workdir /usr/lib
run cp \
	./libgcc_s.so.1 \
	./libintl.so.8 \
	./libluajit-5.1.so.2 \
	./libluv.so.1 \
	./libtree-sitter.so.0.26 \
	./libunibilium.so.4 \
	./libutf8proc.so.3 \
	./libuv.so.1 \
	/copy/lib

workdir /copy/usr/lib/lua/5.1
workdir /usr/lib/lua/5.1
run cp \
	./lpeg.so \
	/copy/usr/lib/lua/5.1

workdir /copy/bin
workdir /usr/bin
run cp ./nvim /copy/bin
cmd [ "sh", "-c", "ls /copy/bin"]

# bin stage (post claw)
from claw as bin
workdir /
cmd [ "sh", "-c", "./claw.sh; nvim -v" ]
